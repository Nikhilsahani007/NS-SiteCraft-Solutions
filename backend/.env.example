# Server Configuration
NODE_ENV=development
PORT=5000

# Database (optional for local development)
# Leave MONGO_URI commented out to run in local mode: enquiries are saved to
# backend/data/enquiries.jsonl and no database is needed.
# MONGO_URI=mongodb://localhost:27017/ns-sitecraft

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=24h

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM_NAME=NS SiteCraft Solutions
SMTP_FROM_EMAIL=noreply@nssitecraft.com

# Admin Email (for notifications)
ADMIN_EMAIL=admin@nssitecraft.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
