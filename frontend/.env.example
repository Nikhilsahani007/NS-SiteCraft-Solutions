# Frontend Configuration

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Where the enquiry form posts. When set, the form uses the project's own API
# instead of EmailJS. .env.development sets it for local runs.
# VITE_ENQUIRY_ENDPOINT=/api/v1/inquiries

# EmailJS Configuration (Optional - for contact form)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Plausible Analytics (Optional - alternative to GA)
# VITE_PLAUSIBLE_DOMAIN=yourdomain.com
